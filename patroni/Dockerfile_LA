FROM python:3.7-bullseye

LABEL maintainer="ORIS Solutions <info@orissolutions.vn>"

SHELL ["/bin/bash", "-xo", "pipefail", "-c"]

ENV LANG=C.UTF-8 \
    ODOO_USER=odoo \
    ODOO_HOME=/opt/odoo \
    ADDONS_PATH=/mnt/extra-addons \
    ODOO_VERSION=11.0

ARG TARGETARCH
ARG ODOO_RELEASE=20210922
ARG ODOO_SHA=6f647eba7005817422a729f426eaca3f64f8fcca

# 0) Upgrade pip & wheel, downgrade setuptools cho legacy use_2to3
RUN pip3 install --no-cache-dir --upgrade pip wheel "setuptools<58"

# 1) Hệ thống dependencies (APT)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl dirmngr gnupg fonts-noto-cjk git \
    libffi-dev libjpeg-dev libldap2-dev libmagic1 libpq-dev libssl-dev \
    libxml2-dev libxslt1-dev node-less npm python3-dev python3-pip \
    python3-psycopg2 python3-gevent python3-greenlet vim git \
    python3-pandas python3-numpy python3-yaml python3-ldap python3-pymongo \
    python3-num2words python3-renderpm python3-vobject python3-watchdog \
    python3-slugify python3-odf python3-pdfminer python3-phonenumbers \
    python3-qrcode python3-xlrd python3-xlwt python3-openpyxl xz-utils \
  && rm -rf /var/lib/apt/lists/*

# 2) Cài wkhtmltopdf Bullseye
RUN ARCH="$(dpkg --print-architecture)" && \
    case "${ARCH}" in \
      amd64) SHA=9df8dd7b1e99782f1cfa19aca665969bbd9cc159 ;; \
      arm64) SHA=58c84db46b11ba0e14abb77a32324b1c257f1f22 ;; \
      ppc64el) SHA=7ed8f6dcedf5345a3dd4eeb58dc89704d862f9cd ;; \
    esac && \
    curl -sSL -o wkhtmltox.deb \
      "https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bullseye_${ARCH}.deb" && \
    echo "${SHA}  wkhtmltox.deb" | sha1sum -c - && \
    apt-get update && apt-get install -y --no-install-recommends ./wkhtmltox.deb && \
    rm -rf /var/lib/apt/lists/* wkhtmltox.deb

# 3) Tạo user odoo & thư mục addons
RUN useradd -m -d /home/${ODOO_USER} -s /bin/bash ${ODOO_USER} && \
    mkdir -p ${ADDONS_PATH} && chown -R ${ODOO_USER}:${ODOO_USER} ${ADDONS_PATH}

# 4) Copy source Odoo 11 và set quyền
RUN mkdir -p ${ODOO_HOME}
COPY odoo_la/odoo-server/ ${ODOO_HOME}/
COPY odoo_la/besco_la/requirements.txt ${ODOO_HOME}/requirements_besco.txt
RUN chown -R ${ODOO_USER}:${ODOO_USER} ${ODOO_HOME}

RUN ln -s ${ODOO_HOME}/odoo-bin /usr/local/bin/odoo-bin

# 5) Patch requirements.txt: loại bỏ các dòng không pip-install được
RUN sed -i '/^\(pandas\|PyYAML\|pyldap\|currency2text\)/d' ${ODOO_HOME}/requirements.txt
RUN sed -i '/^\(pandas\|PyYAML\|pyldap\|currency2text\)/d' ${ODOO_HOME}/requirements_besco.txt
RUN sed -i \
  's|git+https://gitlab.besco.vn/thanh/aeroolib.git@py3|git+https://gitlab.besco.vn/binh.duong/aeroolib@py3|g' \
    ${ODOO_HOME}/requirements_besco.txt

# 6) Cài currency2text trực tiếp từ GitHub
RUN pip3 install --no-cache-dir \
    git+https://github.com/aeroo/currency2text.git#egg=currency2text

RUN pip3 install --no-cache-dir pymongo
RUN pip3 install --no-cache-dir "endesive<1.2"
RUN pip3 install --no-cache-dir "pandas<2.0"
RUN pip3 install --no-cache-dir 'PyYAML<5.1'
RUN pip3 install --no-cache-dir "python-stdnum<1.17"
RUN pip3 install --no-cache-dir Office365-REST-Python-Client pycel shellshock pyfcm firebase-admin

RUN cat << 'EOF' > /usr/local/lib/python3.7/site-packages/sitecustomize.py
try:
    import stdnum.eu.vat as vat
    if not hasattr(vat, "_country_codes"):
        vat._country_codes = getattr(vat, "COUNTRY_CODES", {})
except ImportError:
    pass
EOF

# 7) Cài các Python requirements còn lại
RUN pip3 install --no-cache-dir -r ${ODOO_HOME}/requirements.txt
RUN pip3 install --no-cache-dir -r ${ODOO_HOME}/requirements_besco.txt

# Patch PEP585 generics trong endesive để chạy trên Python 3.7
RUN sed -i '1ifrom typing import List, Tuple' \
      /usr/local/lib/python3.7/site-packages/endesive/verifier.py && \
    sed -i \
      -e 's/certs:list\[x509.Certificate\]/certs:List[x509.Certificate]/' \
      -e 's/-> tuple\[bool, bool, bool\]/-> Tuple[bool, bool, bool]/' \
      /usr/local/lib/python3.7/site-packages/endesive/verifier.py

# Tạo odoo-upgrade wrapper
RUN cat << 'EOF' > /usr/local/bin/odoo-upgrade
#!/bin/bash
# modules list truyền vào dưới dạng module1,module2,...
exec odoo-bin \
  -c /etc/odoo/odoo.conf \
  -d "${DB_NAME:-odoo}" \
  --db_host "${HOST:-db}" \
  --db_port "${PORT:-5432}" \
  --db_user "${USER:-odoo}" \
  --db_password "${PASSWORD:-odoo}" \
  --addons-path "${ADDONS_PATH}" \
  --load-language=en_US \
  --stop-after-init \
  "$@"
EOF
RUN chmod +x /usr/local/bin/odoo-upgrade

# Tạo odoo-shell wrapper
RUN cat << 'EOF' > /usr/local/bin/odoo-shell
#!/bin/bash
# tất cả tham số extra sẽ được truyền tiếp
exec odoo-bin shell \
  -c /etc/odoo/odoo.conf \
  -d "${DB_NAME:-odoo}" \
  --db_host "${HOST:-db}" \
  --db_port "${PORT:-5432}" \
  --db_user "${USER:-odoo}" \
  --db_password "${PASSWORD:-odoo}" \
  --addons-path "${ADDONS_PATH}" \
  -p 8065 "$@"
EOF
RUN chmod +x /usr/local/bin/odoo-shell

# 8) Copy config & entrypoint scripts
COPY entrypoint.sh    /usr/local/bin/entrypoint.sh
COPY odoo.conf         /etc/odoo/odoo.conf
COPY wait-for-psql.py  /usr/local/bin/wait-for-psql.py
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/wait-for-psql.py && \
    chown ${ODOO_USER}:${ODOO_USER} \
      /usr/local/bin/entrypoint.sh /usr/local/bin/wait-for-psql.py /etc/odoo/odoo.conf

# 9) Final
USER ${ODOO_USER}
WORKDIR ${ODOO_HOME}

VOLUME ["/var/lib/odoo","/mnt/extra-addons"]
EXPOSE 8069 8071 8072

ENTRYPOINT ["entrypoint.sh"]
CMD ["odoo-bin","-c","/etc/odoo/odoo.conf"]
